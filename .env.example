# Copie este arquivo para ".env" e preencha os valores.

# Token do bot (Discord Developer Portal > sua aplicação > Bot > Reset Token)
DISCORD_TOKEN=cole_seu_token_aqui

# Pasta onde os chamados serão salvos.
# Local:        ./chamados
# Servidor:     /mnt/servidor/chamados
# Google Drive: /home/usuario/GoogleDrive/Chamados  (via Google Drive Desktop/rclone)
STORAGE_ROOT=./chamados

# (opcional) canal onde o painel será postado automaticamente ao iniciar
PANEL_CHANNEL_ID=0

# IDs de cargos administrativos, separados por vírgula (ex: 123, 456)
ADMIN_ROLE_IDS=1352452252513865796

# tempo máximo de espera por resposta, em segundos (0 = sem limite de tempo).
# Só vale para o fluxo com perguntas; o ticket livre nunca expira.
STEP_TIMEOUT=1800

# true = ticket livre (sem perguntas, só admin fecha); false = fluxo com perguntas
FLUXO_TICKET_LIVRE=true

# ---- Google Drive (opcional) ----
# Deixe GDRIVE_ENABLED=false se não for usar o Drive.
GDRIVE_ENABLED=true
# "oauth" (recomendado para Drive pessoal/Gmail; gere o token.json com
# authorize_drive.py) ou "service_account" (só funciona em Drive compartilhado:
# contas de serviço não têm espaço para gravar arquivos em Drive pessoal).
GDRIVE_AUTH=oauth
GDRIVE_CREDENTIALS=service_account.json
GDRIVE_ROOT_FOLDER_ID=1SjcI_OeUesfNvy-X4gEVFMBh_6lVTdlZ

# ---- Logs administrativos ----
# Os canais de destino são definidos no Discord com /definir_log
# (ou automaticamente pelo nome do canal, ex: logs-tickets-gerados).
# MSG_LOGS_ENABLED ativa mensagens editadas/apagadas e entrada/saída de membros.
MSG_LOGS_ENABLED=true

#
